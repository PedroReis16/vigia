{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vigia.API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Vigia.API",
            "program": "${workspaceFolder}/vigia-api/Vigia.API/bin/Debug/net10.0/Vigia.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/vigia-api/Vigia.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "^\\s*Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/vigia/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:8090;"
            }
        },
        {
            "name": "Vigia.UI",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/vigia_ui",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "Vigia.Bootstrap",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vigia-bootstrap/main.py",
            "cwd": "${workspaceFolder}/vigia-bootstrap",
            "python": "${workspaceFolder}/vigia-bootstrap/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-bootstrap/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Vigia.Fall",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vigia-fall/main.py",
            "cwd": "${workspaceFolder}/vigia-fall",
            "python": "${workspaceFolder}/vigia-fall/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-fall/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Vigia.Fall (capture only)",
            "type": "debugpy",
            "request": "launch",
            "module": "capture",
            "cwd": "${workspaceFolder}/vigia-fall",
            "python": "${workspaceFolder}/vigia-fall/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-fall/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Vigia.OnboardTest (C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build: vigia-onboard-test",
            "program": "${workspaceFolder}/vigia-onboard-test/build/Debug/vigia-capture-cpp.exe",
            "args": [],
            "cwd": "${workspaceFolder}/vigia-onboard-test",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/vigia-onboard-test/.env"
        },
        {
            "name": "Vigia.Onboard.Capture",
            "type": "debugpy",
            "request": "launch",
            "module": "src.bootstrap",
            "cwd": "${workspaceFolder}/vigia-onboard/capture",
            "envFile": "${workspaceFolder}/vigia-onboard/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "onboard: setup capture",
            "windows": {
                "python": "${workspaceFolder}/vigia-onboard/capture/.venv/Scripts/python.exe"
            },
            "osx": {
                "python": "${workspaceFolder}/vigia-onboard/capture/.venv/bin/python"
            },
            "linux": {
                "python": "${workspaceFolder}/vigia-onboard/capture/.venv/bin/python"
            }
        },
        {
            "name": "Vigia.Onboard.Integration",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/vigia-onboard/integration",
            "cwd": "${workspaceFolder}/vigia-onboard/integration",
            "envFile": "${workspaceFolder}/vigia-onboard/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Vigia.Onboard.Bootstrap",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/vigia-onboard/bootstrap",
            "cwd": "${workspaceFolder}/vigia-onboard/bootstrap",
            "envFile": "${workspaceFolder}/vigia-onboard/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Vigia.Onboard.Core",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/vigia-onboard/core",
            "cwd": "${workspaceFolder}/vigia-onboard/core",
            "envFile": "${workspaceFolder}/vigia-onboard/.env",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug All",
            "configurations": [
                "Vigia.API",
                "Vigia.UI"
            ]
        },
        {
            "name": "Debug Edge",
            "configurations": [
                "Vigia.Bootstrap",
                "Vigia.Fall"
            ]
        },
        {
            "name": "Debug Onboard",
            "configurations": [
                "Vigia.Onboard.Capture",
                "Vigia.Onboard.Integration",
                "Vigia.Onboard.Bootstrap",
                "Vigia.Onboard.Core"
            ],
            "stopAll": true
        }
    ]
}