# Modelo do /home/ubuntu/dockers/default.env (env_file da vigia-api na VM).
# Formato ASP.NET Core: Section__SubSection__Key
ASPNETCORE_ENVIRONMENT=Release

# PostgreSQL
ConnectionStrings__VigiaDb=Host=postgres;Port=5432;Database=vigia;Username=admin;Password=admin123

# Redis
ConnectionStrings__Redis=redis:6379

# OAuth (token de serviço para MediaMTX e integrações internas)
OAuth__ServiceToken=1234567890

# mTLS da placa. A CA (vigia-device-ca.crt e .key) fica em ./certificates, montada na API e no Traefik.
# Desligado por ora: placas já registradas e o vigia-devices não enviam certificado de cliente.
# Para ligar: true aqui + router vigia-devices no docker-compose.yaml.
DeviceAuth__RequireClientCertificate=false
DeviceAuth__CaCertificatePath=/certificates/vigia-device-ca.crt
DeviceAuth__CaPrivateKeyPath=/certificates/vigia-device-ca.key

# Basic dos webhooks Orion (alert) e MediaMTX (demand/undemand).
# A senha do MediaMTX é a mesma de VIGIA_MEDIAMTX_PASSWORD no .env do infra.sh.
ServiceBasic__Orion__Username=orion
ServiceBasic__Orion__Password=CHANGE_ME_ORION_PASSWORD
ServiceBasic__MediaMtx__Username=mediamtx
ServiceBasic__MediaMtx__Password=CHANGE_ME_MEDIAMTX_PASSWORD

# Keycloak (access token do vigia-web e do app). Metadados pela rede Docker; iss é a URL pública.
Keycloak__MetadataAddress=http://keycloak:8080/auth/realms/vigia/.well-known/openid-configuration
Keycloak__ValidIssuer=https://services.vigiadeteccoes.com.br/auth/realms/vigia
Keycloak__LogoutRealmBaseUrl=https://services.vigiadeteccoes.com.br/auth/realms/vigia
Keycloak__Audience=vigia-api
# Admin do realm master (KEYCLOAK_ADMIN_USER / KEYCLOAK_ADMIN_PASSWORD do .env da stack).
Keycloak__AdminUsername=admin
Keycloak__AdminPassword=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# RabbitMQ (sync de usuários do Keycloak). Mesma senha de RABBITMQ_PASSWORD no .env da stack.
RabbitMQ__HostName=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=vigia
RabbitMQ__Password=CHANGE_ME_RABBITMQ_PASSWORD

# Public RTMPS endpoint used when provisioning edge devices.
# With infra.sh, ingest listens on Traefik :8443.
Streaming__IngestUrl=rtmps://ingest.vigiadeteccoes.com.br:8443

# FIWARE (Traefik no host — ver serviço fiware no docker-compose)
ApiUrls__Fiware=https://services.vigiadeteccoes.com.br/vigia/fiware/

# Pasta de versões de firmware (volume vigia-api-versions)
VersionPath=/versions/

# Convite: GET /vigia/i/{code} redireciona o desktop para o SPA.
Invite__WebInviteBase=https://vigiadeteccoes.com.br/invite/

# MinIO (S3-compatible)
Cloud__Endpoint=http://minio:9000
Cloud__Region=us-east-1
Cloud__AccessKey=admin
Cloud__SecretKey=admin123
Cloud__VersionsBucketName=vigia-versions
Cloud__PicturesBucketName=vigia-pictures
Cloud__UsePathStyle=true

# Firebase — use CredentialJson (JSON ou Base64).
Firebase__CredentialJson=

# Fiware — Paths / Services / Headers
# Norte NGSI do IoT Agent (Orion encaminha comandos aqui; NÃO usar o path Traefik /iot)
Fiware__ProviderUrl=http://iot-agent:4041
Fiware__Paths__IotAgent=iot
Fiware__Paths__SthComet=sth-comet
Fiware__Paths__Orion=orion
Fiware__Services__ApiKey=VIGIA
Fiware__Services__EntityType=Sensor
Fiware__Services__Resource=
Fiware__RequestHeaders__Service=smart
Fiware__RequestHeaders__ServicePath=/

# Subscriptions[0]
Fiware__Subscriptions__0__Description=Notify Vigia API when {entityType} fall_state is fall
Fiware__Subscriptions__0__Condition__Attrs__0=fall_state
Fiware__Subscriptions__0__Condition__Expression=fall_state==fall
Fiware__Subscriptions__0__Notification__Url=https://services.vigiadeteccoes.com.br/vigia/devices/alert
Fiware__Subscriptions__0__Notification__Attrs__0=fall_state
Fiware__Subscriptions__0__Notification__AttrsFormat=normalized

# Devices
Fiware__Devices__Protocol=PDI-IoTA-UltraLight
Fiware__Devices__Transport=MQTT
# Comandos e atributos dos devices vêm do appsettings.json (não sobrescrever por índice aqui:
# o merge por índice com a lista do appsettings duplica ou perde itens).
