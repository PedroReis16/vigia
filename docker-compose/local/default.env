# Vigia API — variáveis de ambiente para docker-compose local
# Formato ASP.NET Core: Section__SubSection__Key

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
ConnectionStrings__VigiaDb=Host=postgres;Port=5432;Database=vigia;Username=vigia;Password=vigia123

# Redis
ConnectionStrings__Redis=redis:6379

# OAuth (token de serviço para MediaMTX e integrações internas)
OAuth__ServiceToken=1234567890

# Certificado de cliente da placa. Local fica desligado; no deploy a flag é true.
DeviceAuth__RequireClientCertificate=false

# Basic dos webhooks Orion (alert) e MediaMTX (undemand)
ServiceBasic__Orion__Username=orion
ServiceBasic__Orion__Password=dev-orion-password
ServiceBasic__MediaMtx__Username=mediamtx
ServiceBasic__MediaMtx__Password=dev-mediamtx-password

# Keycloak (access token do vigia-web e do app). Metadados pela rede Docker; iss é a URL pública.
# AdditionalValidIssuers cobre o host da LAN que o celular usa em KEYCLOAK_URL.
Keycloak__MetadataAddress=http://keycloak:8080/auth/realms/vigia/.well-known/openid-configuration
# Issuer público do Traefik :81 (vigia-web / keycloak-js). :80 e LAN ficam em AdditionalValidIssuers.
Keycloak__ValidIssuer=http://localhost:81/auth/realms/vigia
# Revoke do refresh: mesma origem do iss (via Traefik no host). keycloak:8080 rejeita o issuer.
Keycloak__LogoutRealmBaseUrl=http://host.docker.internal:81/auth/realms/vigia
Keycloak__AdditionalValidIssuers__0=http://localhost/auth/realms/vigia
Keycloak__AdditionalValidIssuers__1=http://10.0.0.55/auth/realms/vigia
Keycloak__AdditionalValidIssuers__2=http://10.0.0.55:81/auth/realms/vigia
Keycloak__Audience=vigia-api
# Admin do realm master. A API usa para gravar nome, telefone e apagar a conta.
# Mesmo usuário de KC_BOOTSTRAP_ADMIN_* no compose.
Keycloak__AdminUsername=admin
Keycloak__AdminPassword=admin

# RabbitMQ (sync de usuários do Keycloak)
RabbitMQ__HostName=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=vigia
RabbitMQ__Password=vigia123

# Local RTMP endpoint used when provisioning edge devices.
Streaming__IngestUrl=rtmp://host.docker.internal:1935

# FIWARE (Traefik no host — ver serviço fiware no docker-compose)
ApiUrls__Fiware=http://host.docker.internal:81/vigia/fiware/
# Norte NGSI do IoT Agent (Orion encaminha comandos aqui; NÃO usar o path Traefik /iot)
Fiware__ProviderUrl=http://iot-agent:4041

# Pasta de versões de firmware (volume vigia-api-versions)
VersionPath=/versions/

# MinIO (S3-compatible)
Cloud__Endpoint=http://minio:9000
Cloud__Region=us-east-1
Cloud__AccessKey=admin
Cloud__SecretKey=admin123
Cloud__VersionsBucketName=vigia-versions
Cloud__PicturesBucketName=vigia-pictures
Cloud__UsePathStyle=true

# Prefer file (gitignored). Do NOT paste private keys into this tracked env file.
Firebase__CredentialJson=
Firebase__CredentialPath=/run/secrets/firebase-service-account.json
