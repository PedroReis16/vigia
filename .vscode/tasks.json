{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Vigia.API",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "build",
        "${workspaceFolder}/vigia-api/Vigia.API/Vigia.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "onboard: setup capture",
      "type": "shell",
      "command": "make",
      "args": ["capture", "SETUP_ONLY=1"],
      "options": {
        "cwd": "${workspaceFolder}/vigia-onboard"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "onboard: setup core",
      "type": "shell",
      "command": "make",
      "args": ["core", "SETUP_ONLY=1"],
      "options": {
        "cwd": "${workspaceFolder}/vigia-onboard"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "onboard: capture",
      "type": "shell",
      "command": "make",
      "args": ["capture"],
      "options": {
        "cwd": "${workspaceFolder}/vigia-onboard"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "group": "vigia-onboard",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "onboard: core",
      "type": "shell",
      "command": "make",
      "args": ["core"],
      "options": {
        "cwd": "${workspaceFolder}/vigia-onboard"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "group": "vigia-onboard",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "onboard: run",
      "detail": "Terminais do capture e do core",
      "dependsOn": [
        "onboard: capture",
        "onboard: core"
      ],
      "problemMatcher": []
    }
  ]
}
