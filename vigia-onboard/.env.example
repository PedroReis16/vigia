
# Fonte de captura de imagem ou caminho de vídeo
CAPTURE_SOURCE=0

SHOW_VIDEO=true
CAPTURE_LOOP=true
# Stem Ultralytics; em dev exporta on-demand para models/yolo/ (mac CoreML / win ONNX / linux NCNN)
YOLO_MODEL=yolo26s-pose
YOLO_IMGSZ=320

SHOW_PLOT=false
BLUR_VIDEO=false

FRAME_RATE=12
CLASSIFIER=math
SLIDER_WINDOW=30

# Stream / clips (SHM + janela). Workers sobem a partir do capture.
# STREAM_CONTROL_SHM_NAME=vigia-onboard-stream-ctrl
# LIVE_SHM_NAME=vigia-onboard-live
# CLIP_SHM_NAME=vigia-onboard-clip
# CLIP_WINDOW_S=30  # duração; a taxa é a da câmera (CAP_PROP_FPS), não FRAME_RATE
# CLIP_MAX_PAYLOAD=921600

# Provisionamento (identity.json + network.json). Dev local: seed-codes → edge-data/
DATA_DIR=../edge-data
# FALL_SHM_NAME=vigia-onboard-fall
# VIGIA_OTA_DIR=
# VIGIA_INSTALL_ROOT=

# Control plane (interface). Sem hardware LCD/GPIO/BLE no desktop.
LCD_ENABLED=false
BLE_ENABLED=false
DEBUG=true
WIFI_MOCK=true
WIFI_MOCK_RESULT=success
# MOCK_WIFI_SSID=local-mock
# MOCK_WIFI_PASSWORD=unused
# MOCK_API_BASE_URL=http://localhost:8090/vigia
# MOCK_FIWARE_API_KEY=VIGIA
# MOCK_STREAM_INGEST_URL=rtmp://localhost:1935
