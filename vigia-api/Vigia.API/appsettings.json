{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BasePath": "vigia",
  "ConnectionStrings": {
    "VigiaDb": "Host=localhost;Port=5432;Database=vigia;Username=vigia;Password=vigia123",
    "Redis": "localhost:6379"
  },
  "JWT": {
    "SecretKey": "IssoÉUmaChaveSuperSecretaParaCriptografarOsTokensDeUsuariosDoSistema",
    "Issuer": "Vigia",
    "Audience": "Vigia",
    "ExpiresIn": 600,
    "RefreshTokenExpiresIn": 604800
  },
  "Invite": {
    "DeepLinkBase": "vigia://invite/",
    "PublicShareBase": ""
  },
  "RedisCaching": {
    "MaxAge": 3600,
    "InstanceName": "vigia:"
  },
  "MediaMTX": {
    "WebhookToken": ""
  },
  "VersionPath": "/versions/",
  "ApiUrls": {
    "Fiware": "http://localhost:81/vigia/fiware/"
  },
  "Fiware": {
    "Paths": {
      "IotAgent": "iot",
      "SthComet": "sth-comet",
      "Orion": "orion"
    },
    "Services": {
      "ApiKey": "VIGIA",
      "EntityType": "Sensor",
      "Resource": ""
    },
    "RequestHeaders": {
      "Service": "smart",
      "ServicePath": "/"
    },
    "Subscriptions": [
      {
        "Description": "Notify Vigia API when {entityType} fall_state is fall",
        "Condition": {
          "Attrs": [ "fall_state" ],
          "Expression": "fall_state==fall"
        },
        "Notification": {
          "Url": "http://vigia-api:8000/vigia/devices/alert",
          "Attrs": [ "fall_state" ],
          "AttrsFormat": "normalized"
        }
      }
    ],
    "Devices": {
      "Protocol": "PDI-IoTA-UltraLight",
      "Transport": "MQTT",
      "Commands": [
        { "Name": "stream_on", "Type": "command" },
        { "Name": "stream_off", "Type": "command" },
        { "Name": "device_on", "Type": "command" },
        { "Name": "device_off", "Type": "command" },
        { "Name": "device_update", "Type": "command" }
      ],
      "Attributes": [
        { "ObjectId": "s", "Name": "system_status", "Type": "Text" },
        { "ObjectId": "ns", "Name": "network_status", "Type": "Text" },
        { "ObjectId": "ss", "Name": "stream_status", "Type": "Text" },
        { "ObjectId": "dp", "Name": "detected_person", "Type": "Boolean" },
        { "ObjectId": "fall", "Name": "fall_state", "Type": "Text" }
      ]
    }
  },
  "Cloud": {
    "VersionsBucketName": "",
    "PicturesBucketName": "",
    "Endpoint": "",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "UsePathStyle": true
  },
  "Firebase": {
    "CredentialJson": "",
    "CredentialPath": ""
  }
}
