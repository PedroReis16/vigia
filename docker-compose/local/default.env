REDIS_DB=0
REDIS_PASSWORD=admin123
REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_CONNECTION="postgresql://admin:admin123@postgres:5432/vigia"


S3_VIGIA_BUCKET="vigia-releases"

S3_VIGIA_REGION="us-east-1"
S3_VIGIA_ACCESS_KEY_ID=""
S3_VIGIA_SECRET_ACCESS_KEY=""
S3_VIGIA_SESSION_TOKEN=""

# MinIO: endpoint customizado (ex: http://minio:9000). Deixe vazio para AWS S3 padrão.
S3_VIGIA_ENDPOINT="http://minio:9000"
# MinIO exige path-style addressing (true). AWS S3 usa virtual-hosted (false ou vazio).
S3_VIGIA_PATH_STYLE="true"