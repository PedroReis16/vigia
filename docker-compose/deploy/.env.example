ASPNETCORE_ENVIRONMENT=Release

# PostgreSQL
ConnectionStrings__VigiaDb=Host=postgres;Port=5432;Database=vigia;Username=admin;Password=admin123

# Redis
ConnectionStrings__Redis=redis:6379

# OAuth (token de serviço para MediaMTX e integrações internas)
OAuth__ServiceToken=1234567890

# MediaMTX webhooks
MediaMTX__WebhookToken=dev-mediamtx-webhook-token

# FIWARE (Traefik no host — ver serviço fiware no docker-compose)
ApiUrls__Fiware=https://services.vigiadeteccoes.com.br/vigia/fiware/

# Pasta de versões de firmware (volume vigia-api-versions)
VersionPath=/versions/

# MinIO (S3-compatible)
Cloud__Endpoint=http://minio:9000
Cloud__Region=us-east-1
Cloud__AccessKey=admin
Cloud__SecretKey=admin123
Cloud__VersionsBucketName=vigia-versions
Cloud__PicturesBucketName=vigia-pictures
Cloud__UsePathStyle=true

# Firebase — use CredentialJson (JSON ou Base64).
Firebase__CredentialJson=

# Fiware — Paths / Services / Headers
Fiware__Paths__IotAgent=iot
Fiware__Paths__SthComet=sth-comet
Fiware__Paths__Orion=orion
Fiware__Services__ApiKey=VIGIA
Fiware__Services__EntityType=Sensor
Fiware__Services__Resource=
Fiware__RequestHeaders__Service=smart
Fiware__RequestHeaders__ServicePath=/

# Subscriptions[0]
Fiware__Subscriptions__0__Description=Notify Vigia API when {entityType} fall_state is fall
Fiware__Subscriptions__0__Condition__Attrs__0=fall_state
Fiware__Subscriptions__0__Condition__Expression=fall_state==fall
Fiware__Subscriptions__0__Notification__Url=https://services.vigiadeteccoes.com.br/vigia/devices/alert
Fiware__Subscriptions__0__Notification__Attrs__0=fall_state
Fiware__Subscriptions__0__Notification__AttrsFormat=normalized

# Devices
Fiware__Devices__Protocol=PDI-IoTA-UltraLight
Fiware__Devices__Transport=MQTT
# Device Commands
Fiware__Devices__Commands__0__Name=stream_on
Fiware__Devices__Commands__0__Type=command
Fiware__Devices__Commands__1__Name=stream_off
Fiware__Devices__Commands__1__Type=command
Fiware__Devices__Commands__2__Name=device_on
Fiware__Devices__Commands__2__Type=command
Fiware__Devices__Commands__3__Name=device_off
Fiware__Devices__Commands__3__Type=command
Fiware__Devices__Commands__4__Name=device_update
Fiware__Devices__Commands__4__Type=command
# Device Attributes
Fiware__Devices__Attributes__0__ObjectId=s
Fiware__Devices__Attributes__0__Name=system_status
Fiware__Devices__Attributes__0__Type=Text
Fiware__Devices__Attributes__1__ObjectId=ss
Fiware__Devices__Attributes__1__Name=stream_status
Fiware__Devices__Attributes__1__Type=Text
Fiware__Devices__Attributes__2__ObjectId=dp
Fiware__Devices__Attributes__2__Name=detected_person
Fiware__Devices__Attributes__2__Type=Number
Fiware__Devices__Attributes__3__ObjectId=fall
Fiware__Devices__Attributes__3__Name=fall_state
Fiware__Devices__Attributes__3__Type=Text