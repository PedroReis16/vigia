# Unit systemd para o bundle PyInstaller (onedir) instalado pelo vigia-bootstrap.
# --data-dir deve ser a raiz Vigia (ex.: /opt/vigia): contém install.json e fall-detection/.
#
#   sudo install -d -m 755 /opt/vigia
#   sudo install -m 644 cmd/deploy/fall-detection.service /etc/systemd/system/fall-detection.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fall-detection.service
#
# ExecStart alinha com fall-detection/deploy/fall-detection.service e DEPLOY.md.

[Unit]
Description=Vigia Fall Detection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vigia/fall-detection
EnvironmentFile=-/opt/vigia/.env
ExecStart=/opt/vigia/fall-detection/vigia-fall-detection
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
