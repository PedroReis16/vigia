# Docker Hub
DOCKERHUB_USERNAME=pedroreis16

VIGIA_API_IMAGE_TAG=latest

# MediaMTX custom (Alpine + curl/jq para hooks). Build/push a partir de
# docker-compose/dockerfiles/mediamtx.dockerfile — não buildar na VM.
MEDIAMTX_IMAGE=pedroreis16/vigia-mediamtx:latest
VIGIA_MEDIAMTX_TOKEN=

# Traefik ACME DNS-01 (Cloudflare) — Zone:Read + DNS:Edit
CLOUDFLARE_DNS_API_TOKEN=

# Mosquitto
MOSQUITTO_IOTAGENT_PASSWORD=
MOSQUITTO_DEVICE_PASSWORD=

# Portainer — senha do admin inicial (mín. 12 caracteres).
# Cria o usuário admin no primeiro start, sem Setup Token.
PORTAINER_ADMIN_PASSWORD=

# Postgres (suas variáveis existentes)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=