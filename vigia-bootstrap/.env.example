# Desenvolvimento local (macOS/desktop). Na placa: DATA_DIR=/opt/vigia
# Shared mock (TestDeviceSeed): python seed-codes/seed_local_edge.py
DATA_DIR=../edge-data

# Sem hardware LCD/GPIO no Mac
LCD_ENABLED=false
DEBUG=true
WIFI_MOCK=true
WIFI_MOCK_RESULT=success

# Paths de instalação (só na placa, ou override explícito):
# Com DATA_DIR != /opt/vigia, OTA vai para {DATA_DIR}/ota e install root = DATA_DIR.
# Na placa (DATA_DIR=/opt/vigia): OTA = /var/lib/vigia/ota, install = /opt/vigia.
# VIGIA_OTA_DIR=/var/lib/vigia/ota
# VIGIA_INSTALL_ROOT=/opt/vigia
