# =============================================================================
# Dockerfile.linux-arm64-binary
# Gera dist/vigia-fall-detection (onedir) para Linux ARM64.
# Uso: a partir da raiz de vigia-fall — ver `make build-linux-arm64`.
# Pré-requisito: yolo26s-pose.pt na raiz (Makefile chama ensure-model antes).
# =============================================================================

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM --platform=linux/arm64 python:3.12-bookworm AS builder

WORKDIR /build

# Dependências de sistema
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ffmpeg \
      libglib2.0-0 \
      libgomp1 \
      libgl1 \
      libsm6 \
      libxext6 \
 && rm -rf /var/lib/apt/lists/*

# ── Camada de cache: só dependências ─────────────────────────────────────────
COPY requirements.txt requirements-build.txt ./

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple \
      "torch>=2.6,<2.12" "torchvision>=0.21,<0.27" \
 && pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir -r requirements-build.txt \
 && pip uninstall -y opencv-python 2>/dev/null || true \
 && pip install --no-cache-dir --force-reinstall "opencv-python-headless==4.12.0.88"

# ── Camada de código + modelo ────────────────────────────────────────────────
COPY main.py vigia-fall-detection.spec yolo26s-pose.pt ./
COPY capture ./capture
COPY connection ./connection
COPY database ./database
COPY integration ./integration
COPY shared ./shared

# onedir: menor pico de RAM que onefile (evita OOM / exit 137 em Docker).
RUN pyinstaller --clean --noconfirm vigia-fall-detection.spec

# ── Stage 2: imagem mínima — apenas o artefato ───────────────────────────────
# Não use `scratch` aqui: `docker create <imagem>` exige CMD/ENTRYPOINT definidos.
FROM alpine:3.19 AS artifact
COPY --from=builder /build/dist/vigia-fall-detection /vigia-fall-detection
CMD ["/bin/true"]
