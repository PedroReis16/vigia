
# Fonte de captura de imagem ou caminho de vídeo
CAPTURE_SOURCE=0

SHOW_VIDEO=true
CAPTURE_LOOP=true
# Stem Ultralytics; em dev exporta on-demand para models/yolo/ (mac CoreML / win ONNX / linux NCNN)
YOLO_MODEL=yolo26s-pose
YOLO_IMGSZ=320

SHOW_PLOT=false
BLUR_VIDEO=false

FRAME_RATE=12
CLASSIFIER=math
SLIDER_WINDOW=30

# Provisionamento (identity.json + network.json). Dev local: seed-codes → edge-data/
DATA_DIR=../edge-data
# FALL_SHM_NAME=vigia-onboard-fall
# VIGIA_OTA_DIR=
