# Fonte de captura: índice de câmera (ex.: 0) ou caminho/URL de vídeo
CAPTURE_SOURCE=0

SHOW_VIDEO=true
SHOW_YOLO_PLOT=true
CAPTURE_LOOP=true

# Stem ou path absoluto do .onnx (default: artefato do vigia-onboard)
# YOLO_MODEL=../vigia-onboard/vigia-capture/models/yolo/yolo26s-pose.onnx
YOLO_MODEL=yolo26s-pose
YOLO_IMGSZ=320

# Confiança mínima para desenhar detecções
YOLO_CONF=0.25
