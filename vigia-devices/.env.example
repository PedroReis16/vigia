# API atrás do Traefik local (:81). Porta 8090 também funciona (MQTT deriva para :81).
API_BASE_URL=http://localhost:81/vigia
FIWARE_API_KEY=VIGIA
STREAM_INGEST_URL=rtmp://localhost:1935
REDIS_URL=redis://localhost:6379/0

# Opcional: força um ID do device_pool.json (senão claima o primeiro livre).
# Nunca use o TestDeviceSeed/edge: b7e3c9a1-4f2d-4e8b-9c1a-6d5e4f3a2b1c
# DEVICE_ID=a1b2c3d4-e5f6-4789-a012-3456789abcde

# Pasta com MP4s (default: assets/videos ao lado deste arquivo).
# ASSETS_DIR=./assets/videos

# Simulação de queda (segundos). Em demos curtas use valores baixos.
FALL_MIN_S=300
FALL_MAX_S=900
CLIP_WINDOW_S=10
THUMB_INTERVAL_S=60
CLAIM_TTL_S=30

LOG_LEVEL=INFO
