# Modelo do /home/ubuntu/dockers/.env — lido pelo infra.sh e pelo docker-compose.yaml.
# NÃO versionar o arquivo real.

# ─── infra.sh ────────────────────────────────────────────────────────────────
# Token Cloudflare com Zone:Read + DNS:Edit (aliases aceitos: CF_DNS_API_TOKEN, DNS_API_TOKEN)
CLOUDFLARE_DNS_API_TOKEN=
MOSQUITTO_IOTAGENT_PASSWORD=
MOSQUITTO_DEVICE_PASSWORD=
# mín. 12 caracteres
PORTAINER_ADMIN_PASSWORD=
# Basic dos hooks do MediaMTX → ServiceBasic__MediaMtx__* no default.env
VIGIA_MEDIAMTX_USER=mediamtx
VIGIA_MEDIAMTX_PASSWORD=

# ─── docker-compose.yaml (stack de aplicação) ────────────────────────────────
# Superusuário do Postgres do infra.sh (cria role/schema do Keycloak)
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin123
KEYCLOAK_DB_PASSWORD=
# URL pública do Keycloak (KC_HOSTNAME). Default: https://vigiadeteccoes.com.br/auth
KEYCLOAK_PUBLIC_URL=https://vigiadeteccoes.com.br/auth
# Admin do realm master → Keycloak__AdminUsername/AdminPassword no default.env
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Usuário "admin" do realm vigia (login do vigia-web)
KEYCLOAK_REALM_ADMIN_PASSWORD=
# → RabbitMQ__Username/Password no default.env
RABBITMQ_USER=vigia
RABBITMQ_PASSWORD=
# Intervalo da queda simulada do vigia-devices (segundos)
WORKER_FALL_MIN_S=300
WORKER_FALL_MAX_S=900
