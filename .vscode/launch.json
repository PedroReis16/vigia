{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vigia.API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Vigia.API",
            "program": "${workspaceFolder}/vigia-api/Vigia.API/bin/Debug/net10.0/Vigia.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/vigia-api/Vigia.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "^\\s*Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/vigia/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:8090;"
            }
        },
        {
            "name": "Vigia.UI",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/vigia_ui",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "Vigia.Bootstrap",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vigia-bootstrap/main.py",
            "cwd": "${workspaceFolder}/vigia-bootstrap",
            "python": "${workspaceFolder}/vigia-bootstrap/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-bootstrap/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Vigia.Fall",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vigia-fall/main.py",
            "cwd": "${workspaceFolder}/vigia-fall",
            "python": "${workspaceFolder}/vigia-fall/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-fall/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Vigia.Fall (capture only)",
            "type": "debugpy",
            "request": "launch",
            "module": "capture",
            "cwd": "${workspaceFolder}/vigia-fall",
            "python": "${workspaceFolder}/vigia-fall/.venv/bin/python",
            "envFile": "${workspaceFolder}/vigia-fall/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Debug All",
            "configurations": [
                "Vigia.API",
                "Vigia.UI"
            ]
        },
        {
            "name": "Debug Edge",
            "configurations": [
                "Vigia.Bootstrap",
                "Vigia.Fall"
            ]
        }
    ]
}
