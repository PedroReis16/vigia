# Nome do modelo (ex.: yolo26s-pose) ou caminho absoluto para um .pt.
# No bundle PyInstaller, o nome resolve para o yolo26s-pose.pt empacotado.
YOLO_POSE_MODEL=yolo26s-pose

# Fonte de vídeo: índice da câmera (0, 1, …) ou caminho para um arquivo de vídeo.
# CAPTURE_SOURCE=0
CAPTURE_SOURCE=~/Downloads/video (36).avi
# Repetir o vídeo ao terminar (útil em simulação local).
# CAPTURE_LOOP=true

# Exibir vídeo de callback em debug.
# Na placa (serviço systemd): SHOW_VIDEO=false
# Local: make install-local-deps (OpenCV GUI). NÃO misturar com install-build-deps (headless).
SHOW_VIDEO=true

# Taxa de captura de frames
FRAME_RATE=12

# Tamanho da janela deslizante de processamento
SLIDE_WINDOW=30

# Diretório de dados (identity.json, network.json, classifier.json)
DATA_DIR=/opt/vigia

# Classificador de queda: preferência em {DATA_DIR}/classifier.json
# {"classifier":"math"|"gru"} — default math; selecionável no LCD do bootstrap.

# Debug local: true usa MockWifiService; false usa nmcli (NetworkManager).
# Na placa (serviço systemd): DEBUG=false
DEBUG=true

# Resultado forçado do mock Wi‑Fi: success | fail
WIFI_MOCK_RESULT=success